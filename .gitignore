.cxx/
.externalNativeBuild/
.DS_Store
/dist/
/captures/

# Local SDK configuration, credentials and signing material
local.properties
.env
.env.*
*.env
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
keystore.properties
signing.properties
*credentials*

# Compiled artifacts; the Gradle wrapper JAR is intentionally retained
*.[aA][pP][kK]
*.[aA][aA][bB]

# Private activity exports, databases, screenshots and diagnostics
*.[tT][cC][xX]
*.[gG][pP][xX]
*.db
*.db-*
*.sqlite
*.sqlite3
*.log
/testreal/
